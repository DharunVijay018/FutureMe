# FutureMe Vault Environment Configuration
# Copy this file to .env.local and configure external service credentials as needed.

# ============================================================================
# SUPABASE CONFIGURATION (PostgreSQL Database & Authentication)
# ============================================================================
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SERVER-SIDE ONLY - NEVER expose to client browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ============================================================================
# EMAIL NOTIFICATION PROVIDER (Optional)
# ============================================================================
# If omitted, notifications are safely recorded as pending/logged without errors.
RESEND_API_KEY=re_123456789...
NOTIFICATION_SENDER_EMAIL=capsules@futuremevault.io

# ============================================================================
# SCHEDULED BACKGROUND JOBS (CRON)
# ============================================================================
# Bearer secret for authenticating /api/cron/process-notifications
CRON_SECRET=vault_dev_cron_secret_2026

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
